# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kop_platform?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App URLs
APP_URL="http://localhost:5173"
API_URL="http://localhost:3000"
API_PORT=3000

# Invitations
INVITATION_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# Email (SMTP) — leave empty for local dev (tokens shown in API/UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OLSC Lebanon <noreply@olsclebanon.com>"

# Seed Super Admin
SEED_SUPER_ADMIN_EMAIL="admin@olsclebanon.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMeNow123!"
SEED_SUPER_ADMIN_FIRST_NAME="OLSC"
SEED_SUPER_ADMIN_LAST_NAME="Admin"

# Cloudinary (optional — local disk used when empty)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_AVATAR_FOLDER="kop/avatars"
