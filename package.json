{
  "name": "kop-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Official digital platform for OLSC Lebanon",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @kop/api",
    "dev:web": "npm run dev -w @kop/web",
    "build": "npm run build -w @kop/shared && npm run build -w @kop/api && npm run build -w @kop/web",
    "build:shared": "npm run build -w @kop/shared",
    "prisma:generate": "npm run prisma:generate -w @kop/api",
    "prisma:migrate": "npm run prisma:migrate -w @kop/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w @kop/api",
    "prisma:seed": "npm run prisma:seed -w @kop/api",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "lint": "npm run lint -w @kop/api && npm run lint -w @kop/web"
  },
  "engines": {
    "node": ">=20"
  }
}
