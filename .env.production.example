# Production environment — copy to `.env` before deploy

NODE_ENV=production

# Database (docker-compose.prod uses postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL="postgresql://postgres:replace-with-strong-db-password@postgres:5432/kop_platform?schema=public"

# JWT — generate long random strings (min 32 chars)
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public URLs (use your real domain + HTTPS in production)
APP_URL="https://app.olsclebanon.com"
API_URL="https://api.olsclebanon.com"
API_PORT=3000
WEB_PORT=8080
VITE_API_URL="https://api.olsclebanon.com/api"
CORS_ORIGINS=""

# Invitations & password reset
INVITATION_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# Email (SMTP) — required for production invitations & password reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@olsclebanon.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="OLSC Lebanon <noreply@olsclebanon.com>"

# Cloudinary — recommended for production avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=kop/avatars

# Seed Super Admin (first deploy only — change password after login)
SEED_SUPER_ADMIN_EMAIL="admin@olsclebanon.com"
SEED_SUPER_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword!"
SEED_SUPER_ADMIN_FIRST_NAME="OLSC"
SEED_SUPER_ADMIN_LAST_NAME="Admin"
